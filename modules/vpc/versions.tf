###############################################################################
# 모듈 레벨 버전 제약
#
# 모듈은 자기 자신의 최소 호환성을 명시하지만, provider 인스턴스 자체는
# 호출자(envs/dev)가 주입한다. 즉 여기엔 provider "aws" {} 블록을 두지 않는다.
###############################################################################

terraform {
  required_version = ">= 1.14"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = ">= 6.0, < 7.0"
    }
  }
}
